# Copia este archivo como .env.local para trabajar en local.
# En producción, estas variables se configuran en Vercel (Settings > Environment Variables).
# NUNCA pongas aquí claves reales ni subas .env.local a GitHub.
# NUNCA uses el prefijo NEXT_PUBLIC_ en una clave secreta: quedaría visible en el navegador.

# Clave del proveedor de IA (Claude, Gemini, Groq...). Solo se lee en el servidor.
AI_API_KEY=

# Credenciales de afiliación (Amazon Creators API, AWIN...). Solo en el servidor.
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AWIN_API_TOKEN=
